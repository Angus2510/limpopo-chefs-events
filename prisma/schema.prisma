generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Booking {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firstName String
  lastName  String
  email     String
  phone     String?

  eventId           String
  eventTitle        String
  bookingChoiceId   String?
  bookingChoiceLabel String?
  campus            String
  date              String
  participants      Int

  amount   Int
  currency String @default("ZAR")
  status   String @default("pending")

  yocoCheckoutId    String? @unique
  yocoPaymentId     String?
  clientReferenceId String? @unique

  @@index([eventId, date, campus, status])
  @@index([createdAt])
}